# Copy to .env beside compose.yaml, fill in, then `chmod 600 .env`.
# Every value here is a placeholder. Generate each secret on the server and
# keep a copy of this file somewhere other than the server (a password
# manager): the backups do not include it, and a restore needs CELL_KEK.

# --- Images --------------------------------------------------------------
# A commit SHA from main, as CI tags the images. `main` follows the latest
# build, which makes a rollback a guess; prefer a SHA.
IMAGE_TAG=0000000000000000000000000000000000000000
# IMAGE_PREFIX=ghcr.io/salamaashoush/faridalms

# --- Names ---------------------------------------------------------------
# <slug>.PORTAL_DOMAIN is a school's portal, <slug>.SITES_DOMAIN its website.
PORTAL_DOMAIN=faridalms.com
SITES_DOMAIN=faridalms.site
# The server's public IPv4: a school's own apex domain points its A record
# here. Unset, schools can only bind subdomains.
EDGE_IPV4=203.0.113.10

# --- The cell --------------------------------------------------------------
# Two lowercase letters, a hyphen and a number. It names the cell in the
# directory and in key derivation, so it never changes once data exists.
CELL_ID=eu-1

# --- Generated secrets -------------------------------------------------------
# Hex, because both go into connection URLs:  openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
# Every login role of the cell (app, site, worker, collab, provisioner,
# directory_*, backup_dump) uses it; the migrate job sets it on each role.
CELL_ROLE_PASSWORD=replace-with-openssl-rand-hex-32
# Base64:  openssl rand -base64 32
# Wraps every tenant's data keys. Lose it and encrypted fields are gone,
# backups included; change it and the cell cannot read them.
CELL_KEK=replace-with-openssl-rand-base64-32
# Shared by the API, collab and the media service. Changing it invalidates
# every file and stream link, collaboration ticket and sign-in counter key.
CELL_SECRET=replace-with-openssl-rand-base64-32
# Shared by the console and the provisioner only.
PROVISION_SECRET=replace-with-openssl-rand-base64-32
# Seals the console's session cookie; changing it signs every operator out.
OPS_SESSION_SECRET=replace-with-openssl-rand-base64-32

# --- Edge --------------------------------------------------------------------
# A Cloudflare API token limited to Zone > DNS > Edit and Zone > Zone > Read
# on the two zones, for the wildcard certificates (DNS-01).
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-token
# DEBUG logs every proxied request with its headers; leave INFO otherwise.
# EDGE_LOG_LEVEL=INFO

# --- File store: Hetzner Object Storage, Helsinki ---------------------------
S3_ENDPOINT=https://hel1.your-objectstorage.com
S3_REGION=hel1
# Hetzner documents buckets as https://<bucket>.hel1.your-objectstorage.com.
S3_ADDRESSING_STYLE=virtual
S3_ACCESS_KEY_ID=replace-with-hetzner-access-key
S3_SECRET_ACCESS_KEY=replace-with-hetzner-secret-key
FILE_BUCKET=faridalms-files
PUBLIC_MEDIA_BUCKET=faridalms-media

# --- Operator console: Google sign-in -----------------------------------------
# A Google OAuth client of type "Web application" whose authorised redirect
# URI is https://ops.<PORTAL_DOMAIN>/auth/callback (README.md, "Console").
OPS_OIDC_ISSUER=https://accounts.google.com
OPS_OIDC_CLIENT_ID=replace-with-client-id.apps.googleusercontent.com
OPS_OIDC_CLIENT_SECRET=replace-with-client-secret
# Who may sign in: the accounts with these verified emails, comma-separated,
# or, with a provider that has groups, OPS_OIDC_GROUP instead. Not both.
OPS_OIDC_EMAILS=operator@example.com
# OPS_OIDC_GROUP=
# OPS_OIDC_GROUP_CLAIM=groups

# --- Notifications -------------------------------------------------------------
# Email goes through Resend, from a sender on a domain verified there. Without
# an email gateway nobody can be invited or reset a password, notifications
# are recorded as skipped, and the provisioner refuses to create a school,
# since its first administrator could never sign in.
RESEND_API_KEY=replace-with-resend-key
EMAIL_FROM=Farida <no-reply@mail.faridalms.com>
# Or, instead of Resend, HTTPS endpoints taking a JSON POST
# { to, subject, text } with the bearer token below. SMS has only this form.
EMAIL_WEBHOOK_URL=
SMS_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=

# --- Optional ------------------------------------------------------------------
# Where the source of the running copy is published; the AGPL asks for it.
SOURCE_URL=
# The largest upload, in bytes (default 25 MiB). Above 30 MiB, raise the
# edge's request_body limit in the Caddyfile with it.
# MAX_UPLOAD_BYTES=26214400
# host:port of a clamd daemon to scan every upload.
# CLAMD_ADDRESS=

# --- Backups -------------------------------------------------------------------
# A bucket at another provider, with object lock, and keys that may write and
# list but not delete. Leave these empty and the nightly job logs that it is
# not configured and does nothing.
# BACKUP_AT=02:30
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
