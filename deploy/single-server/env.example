# Copy to .env beside compose.yaml, fill in, then `chmod 600 .env`.
# Every value here is a placeholder. Generate each secret on the server and
# keep a copy of this file somewhere other than the server (a password
# manager): the backups do not include it, and a restore needs CELL_KEK.

# --- What runs ----------------------------------------------------------------
# Optional parts, comma-separated (README.md, "What runs"):
#   storage  a file store on this server, for when there is no S3 service
#   console  the operator console, signed in through OpenID Connect
COMPOSE_PROFILES=storage

# --- Images --------------------------------------------------------------
# A commit SHA from main, as CI tags the images. `main` follows the latest
# build, which makes a rollback a guess; prefer a SHA.
IMAGE_TAG=0000000000000000000000000000000000000000
# IMAGE_PREFIX=ghcr.io/salamaashoush/faridalms

# --- Names ---------------------------------------------------------------
# Two domains of their own, both pointed at this server with a wildcard
# (README.md, "DNS"). <school>.PORTAL_DOMAIN is a school's portal, where
# people sign in; <school>.SITES_DOMAIN its public website. Students' code
# runs under SITES_DOMAIN, so it must be another registrable domain, never a
# subdomain of PORTAL_DOMAIN.
PORTAL_DOMAIN=example.com
SITES_DOMAIN=example.net
# The server's public IPv4: a school's own apex domain points its A record
# here. Unset, schools can only bind subdomains.
EDGE_IPV4=203.0.113.10

# --- The cell --------------------------------------------------------------
# Two lowercase letters, a hyphen and a number. It names the cell in the
# directory and in key derivation, so it never changes once data exists.
CELL_ID=eu-1
# The two-letter country the data is kept in.
CELL_JURISDICTION=EG
# Where the server is, as the directory records it.
# CELL_PROVIDER=self-hosted
# CELL_REGION=default

# --- Generated secrets -------------------------------------------------------
# Hex, because both go into connection URLs:  openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
# Every login role of the cell (app, site, worker, collab, provisioner,
# directory_*, business_admin, backup_dump) uses it; the migrate job sets it
# on each role.
CELL_ROLE_PASSWORD=replace-with-openssl-rand-hex-32
# Base64:  openssl rand -base64 32
# Wraps every tenant's data keys. Lose it and encrypted fields are gone,
# backups included; change it and the cell cannot read them.
CELL_KEK=replace-with-openssl-rand-base64-32
# Shared by the API, collab and the media service. Changing it invalidates
# every file and stream link, collaboration ticket and sign-in counter key.
CELL_SECRET=replace-with-openssl-rand-base64-32
# Keys the directory's index of sign-in names, which lets the bare portal
# domain find a person's school from their email. Every cell of the platform
# shares it. Changing it means rebuilding the index, so never rotate it casually.
LOGIN_INDEX_KEY=replace-with-openssl-rand-base64-32

# --- Edge --------------------------------------------------------------------
# acme (default): each name gets a certificate from Let's Encrypt on its
# first visit, over ports 80 and 443, with nothing else to set up.
# cloudflare: two wildcard certificates by DNS-01, with a Cloudflare API
# token limited to Zone > DNS > Edit and Zone > Zone > Read on both zones.
EDGE_TLS=acme
# CLOUDFLARE_API_TOKEN=
# DEBUG logs every proxied request with its headers; leave INFO otherwise.
# EDGE_LOG_LEVEL=INFO

# --- File store -----------------------------------------------------------------
# With the storage profile, the store runs on this server: keep these two
# lines, and choose the keys it is to accept (openssl rand -hex 16 and 32).
S3_ENDPOINT=http://storage:8333
S3_ADDRESSING_STYLE=path
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-openssl-rand-hex-16
S3_SECRET_ACCESS_KEY=replace-with-openssl-rand-hex-32
FILE_BUCKET=farida-files
PUBLIC_MEDIA_BUCKET=farida-media
# Or an S3 service, with its endpoint, region and keys and two private
# buckets made there; Hetzner Object Storage, for one, documents buckets as
# https://<bucket>.<endpoint host>, which is S3_ADDRESSING_STYLE=virtual.
# S3_ENDPOINT=https://hel1.your-objectstorage.com
# S3_REGION=hel1
# S3_ADDRESSING_STYLE=virtual

# --- Email ---------------------------------------------------------------------
# Every invitation, password reset and notification goes by email. Through
# Resend, from a sender on a domain verified there:
RESEND_API_KEY=replace-with-resend-key
EMAIL_FROM=School <no-reply@mail.example.com>
# Families answer a conversation's email back into it: a subdomain whose MX
# points at Resend's receiving, and the signing secret of a Resend webhook for
# email.received at https://api.<PORTAL_DOMAIN>/callbacks/resend. Unset,
# answers go to the school's own address (docs/operations.md, "Conversations
# by email").
# INBOUND_EMAIL_DOMAIN=reply.example.com
# RESEND_WEBHOOK_SECRET=whsec_replace-with-webhook-secret
# Or HTTPS endpoints taking a JSON POST { to, subject, text } with the bearer
# token below. SMS has only this form.
# EMAIL_WEBHOOK_URL=
# SMS_WEBHOOK_URL=
# NOTIFY_WEBHOOK_TOKEN=

# --- Operator console (console profile) ----------------------------------------
# Without it, schools are created from the shell (README.md, "First school").
# Base64 secrets:  openssl rand -base64 32
# PROVISION_SECRET=
# OPS_SESSION_SECRET=
# Demonstration requests and schools' questions about a module reach the
# console as leads, signed with this; unset, none is sent.
# INTAKE_SECRET=
# An OpenID Connect client whose redirect URI is
# https://ops.<PORTAL_DOMAIN>/auth/callback; Google's issuer is below.
# OPS_OIDC_ISSUER=https://accounts.google.com
# OPS_OIDC_CLIENT_ID=
# OPS_OIDC_CLIENT_SECRET=
# Who may sign in: the accounts with these verified emails, comma-separated,
# or, with a provider that has groups, OPS_OIDC_GROUP instead. Not both.
# OPS_OIDC_EMAILS=operator@example.com
# OPS_OIDC_GROUP=
# OPS_OIDC_GROUP_CLAIM=groups

# --- Optional ------------------------------------------------------------------
# The largest upload, in bytes (default 25 MiB). Above 30 MiB, raise the
# edge's request_body limit in the Caddyfile with it.
# MAX_UPLOAD_BYTES=26214400
# host:port of a clamd daemon to scan every upload.
# CLAMD_ADDRESS=

# --- Backups -------------------------------------------------------------------
# A bucket at another provider, with object lock, and keys that may write and
# list but not delete. Leave these empty and the nightly job logs that it is
# not configured and does nothing.
# BACKUP_AT=02:30
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
