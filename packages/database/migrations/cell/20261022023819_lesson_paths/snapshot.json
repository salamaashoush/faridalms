    {
      "op": "create",
      "row": {
        "schema": "core",
        "table": "lessons",
        "name": "lessons_condition_check",
        "value": "case when condition_lesson_id is null\n        then condition_at_least is null and condition_below is null\n        else condition_lesson_id <> id\n          and (condition_at_least is not null or condition_below is not null)\n          and coalesce(condition_at_least between 1 and 100, true)\n          and coalesce(condition_below between 1 and 100, true)\n          and coalesce(condition_at_least < condition_below, true) end",
        "entityType": "checks"
      }
