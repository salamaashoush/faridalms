{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "jsx-a11y",
    "import",
    "unicorn",
    "oxc",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "settings": {
    "react": {
      "version": "19.0"
    }
  },
  "jsPlugins": [
    { "name": "router", "specifier": "oxlint-plugin-router" },
    { "name": "query", "specifier": "oxlint-plugin-query" }
  ],
  "rules": {
    "no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    "no-restricted-properties": [
      "error",
      {
        "object": "process",
        "property": "env",
        "message": "Use `import { env } from '~/env'` instead to ensure validated types."
      }
    ],

    "typescript/consistent-type-imports": [
      "warn",
      { "prefer": "type-imports", "fixStyle": "separate-type-imports" }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    // Not part of the ESLint config this replaced. Enabling it is an opt-in
    // decision: it fires on idiomatic `as` in the vendored shadcn components.
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-misused-promises": [
      "error",
      { "checksVoidReturn": { "attributes": false } }
    ],
    "typescript/no-unnecessary-condition": [
      "error",
      { "allowConstantLoopConditions": true }
    ],

    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-key": "error",
    // React 19 automatic JSX runtime: React need not be in scope.
    "react/react-in-jsx-scope": "off",

    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    "import/first": "error",
    "import/newline-after-import": "error",
    "import/no-duplicates": "error",
    // Side-effect imports (e.g. "vitest-dom/extend-expect") are intentional.
    "import/no-unassigned-import": "off",

    "router/create-route-property-order": "error"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "overrides": [
    {
      // Registry state-updater parameters intentionally name the previous state;
      // they are local values, not references to the outer open state.
      "files": ["packages/ui/src/sidebar.tsx"],
      "rules": { "no-shadow": "off" }
    },
    {
      // The registry hook synchronizes matchMedia after hydration. Its initial
      // effect reads that external browser state while keeping SSR deterministic.
      "files": ["packages/ui/src/use-mobile.ts"],
      "rules": { "react/set-state-in-effect": "off" }
    },
    {
      // The registry addon only forwards pointer focus to its keyboard-focusable
      // input. It performs no action and must not create a second tab stop.
      "files": ["packages/ui/src/input-group.tsx"],
      "rules": {
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off"
      }
    },
    {
      // These run outside the Vite graph, so `~/env` (which reads
      // `import.meta.env`) is not available to them.
      "files": [
        "apps/web/src/env.ts",
        "playwright.config.ts",
        "drizzle*.config.ts",
        "apps/api/src/env.ts",
        "apps/api/src/admin-env.ts",
        "apps/collab/src/env.ts",
        "apps/ops/src/server/env.ts",
        "e2e/fixtures/**",
        "scripts/**",
        "packages/database/test/**",
        "apps/api/test/**",
        "apps/ops/test/**",
        ".husky/**"
      ],
      "rules": {
        "no-restricted-properties": "off"
      }
    },
    {
      // Provisioning, migrations, the seed and the database suites issue
      // statements on one connection, where each depends on what the previous
      // one created. Promise.all would reorder them, not speed them up.
      "files": [
        "packages/database/src/migrate.ts",
        "packages/database/src/provision.ts",
        "packages/database/src/seed.ts",
        "packages/database/test/**",
        "scripts/db.ts",
        "scripts/db-verify.ts",
        "scripts/check-sources.ts"
      ],
      "rules": { "no-await-in-loop": "off" }
    },
    {
      "files": ["**/*.spec.ts", "**/*.spec.tsx", "e2e/**"],
      "rules": {
        "vitest/require-mock-type-parameters": "off"
      }
    },
    {
      // Server-only, no React here. TanStack's session API is named
      // `useSession` but is not a React hook, so the hooks rule cannot be
      // satisfied by any naming these files could adopt.
      "files": ["apps/web/src/utils/session.ts", "apps/web/src/server/**"],
      "rules": {
        "react-hooks/rules-of-hooks": "off"
      }
    },
    {
      // Lexical keeps node state in `__`-prefixed fields and its own base
      // classes define `__key`, `__format` and friends, which subclasses must
      // read and write under those names for clone() and getWritable() to work.
      "files": ["packages/editor/src/nodes/**"],
      "rules": { "no-underscore-dangle": "off" }
    },
    {
      // The micro:bit editor is framed from the files host, another site
      // from the page around it, where keeping its origin gives it the
      // storage and workers it needs and nothing of ours. The rule guards
      // against a frame of the page's own origin, which could undo its
      // sandbox; this one cannot reach the page at all.
      "files": ["packages/makecode/src/Studio.tsx"],
      "rules": { "react/iframe-missing-sandbox": "off" }
    },
    {
      // The Scratch editor seeds a new project's pictures and sounds through
      // its storage's `_store`; the public `store` beside it only warns that
      // it is deprecated and calls the same thing.
      "files": ["apps/api/studio/host.js"],
      "rules": { "no-underscore-dangle": "off" }
    },
    {
      // The menus typed for at the caret (slash, mentions) are listboxes the
      // contenteditable drives through aria-activedescendant, so focus and
      // arrow keys stay in the editor. A native <select> cannot float at the
      // caret without taking focus.
      "files": ["packages/editor/src/plugins/typeahead.tsx"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/click-events-have-key-events": "off"
      }
    },
    {
      // Embeds are cross-origin players from a fixed allowlist. allow-same-origin
      // keeps each frame in its own origin, never ours, and the YouTube, Vimeo
      // and Google players need it to keep playback state. The coding studio
      // is served from a registrable domain of its own, so the same pair keeps
      // it in that origin, with the storage and workers it needs.
      "files": [
        "packages/editor/src/media-view.tsx",
        "apps/web/src/components/coding/StudioFrame.tsx"
      ],
      "rules": { "react/iframe-missing-sandbox": "off" }
    },
    {
      // Vendored shadcn registry code: regenerated by `shadcn add`, so local
      // edits to satisfy these are lost on the next re-sync. Correctness rules
      // still apply; only house-style and registry-design rules are relaxed.
      "files": ["packages/ui/src/**"],
      "rules": {
        "import/consistent-type-specifier-style": "off",
        "jsx-a11y/label-has-associated-control": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "react/no-array-index-key": "off",
        "typescript/no-unnecessary-condition": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    ".claude/**",
    "apps/web/src/i18n/**",
    "apps/web/src/i18n-dev/**",
    "apps/web/src/routeTree.gen.ts",
    "apps/ops/src/routeTree.gen.ts",
    "**/.output/**",
    "**/.nitro/**",
    "dist/**",
    "coverage/**",
    "playwright-report/**"
  ]
}
