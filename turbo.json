{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", "dist/**"],
      "env": ["BACKEND_URL", "NODE_ENV"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/messages/**",
        "$TURBO_ROOT$/project.inlang/**",
        "$TURBO_ROOT$/paraglide.options.ts"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
