BACKEND_URL=http://127.0.0.1:3001
API_PORT=3001
# The files host serves signed downloads; give it its own domain in production.
# FILES_PORT=3003
# FILES_ORIGIN=https://files.example.com
FILE_STORAGE=disk
FILE_STORAGE_DIR=.data/files
# With FILE_STORAGE=s3: any S3-compatible service.
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# FILE_BUCKET=acme-files
# PUBLIC_MEDIA_BUCKET=acme-public-media
MAX_UPLOAD_BYTES=26214400
# Reports each school's storage to the directory for the operator console.
# DIRECTORY_SYNC_URL=postgres://directory_sync:${CELL_ROLE_PASSWORD}@127.0.0.1:5433/${DIRECTORY_DATABASE}
# The regional cell. The admin URL is a superuser used only by development and
# test tooling to create roles and databases; bun install generates the rest.
DATABASE_ADMIN_URL=postgres://northwind:northwind@127.0.0.1:5433/postgres
CELL_DATABASE=cell
DIRECTORY_DATABASE=directory
CELL_ID=eg-1
CELL_ROLE_PASSWORD=
CELL_KEK=
CELL_SECRET=
# The API's connections, one login role each. Bun expands the references.
CELL_APP_URL=postgres://app:${CELL_ROLE_PASSWORD}@127.0.0.1:5433/${CELL_DATABASE}
CELL_SITE_URL=postgres://site:${CELL_ROLE_PASSWORD}@127.0.0.1:5433/${CELL_DATABASE}
CELL_WORKER_URL=postgres://worker:${CELL_ROLE_PASSWORD}@127.0.0.1:5433/${CELL_DATABASE}
CELL_RETENTION_URL=postgres://retention:${CELL_ROLE_PASSWORD}@127.0.0.1:5433/${CELL_DATABASE}
CELL_COLLAB_URL=postgres://collab:${CELL_ROLE_PASSWORD}@127.0.0.1:5433/${CELL_DATABASE}
DIRECTORY_URL=postgres://directory_reader:${CELL_ROLE_PASSWORD}@127.0.0.1:5433/${DIRECTORY_DATABASE}
# The live-editing server, and where browsers reach it.
COLLAB_PORT=3002
COLLAB_URL=ws://127.0.0.1:3002
# Email and SMS gateways taking a JSON POST; without one, that channel is
# logged as skipped in the delivery log.
# EMAIL_WEBHOOK_URL=
# SMS_WEBHOOK_URL=
# NOTIFY_WEBHOOK_TOKEN=
# Hosts of the form <school>.<APP_HOST> name their school; *.localhost resolves locally.
APP_HOST=localhost
