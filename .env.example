BACKEND_URL=http://127.0.0.1:3001
API_PORT=3001
# Proxies in front of web and API that append to X-Forwarded-For.
# TRUSTED_PROXY_HOPS=1
# The files host serves signed downloads; give it its own domain in production.
# FILES_PORT=3003
# FILES_ORIGIN=https://files.example.com
FILE_STORAGE=disk
FILE_STORAGE_DIR=.data/files
# With FILE_STORAGE=s3: any S3-compatible service.
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# FILE_BUCKET=acme-files
# PUBLIC_MEDIA_BUCKET=acme-public-media
MAX_UPLOAD_BYTES=26214400
# The regional cell. The admin URL is a superuser used only by development and
# test tooling to create roles and databases; bun install generates the rest.
DATABASE_ADMIN_URL=postgres://farida:farida@127.0.0.1:5433/postgres
CELL_DATABASE=cell
DIRECTORY_DATABASE=directory
CELL_ID=eg-1
CELL_ROLE_PASSWORD=
CELL_KEK=
CELL_SECRET=
# Keys the directory's index of sign-in names; every cell of a platform shares it.
LOGIN_INDEX_KEY=
# The API's connections, one login role each. Bun expands the references.
CELL_APP_URL=postgres://app:${CELL_ROLE_PASSWORD}@127.0.0.1:5433/${CELL_DATABASE}
CELL_SITE_URL=postgres://site:${CELL_ROLE_PASSWORD}@127.0.0.1:5433/${CELL_DATABASE}
CELL_WORKER_URL=postgres://worker:${CELL_ROLE_PASSWORD}@127.0.0.1:5433/${CELL_DATABASE}
CELL_RETENTION_URL=postgres://retention:${CELL_ROLE_PASSWORD}@127.0.0.1:5433/${CELL_DATABASE}
CELL_COLLAB_URL=postgres://collab:${CELL_ROLE_PASSWORD}@127.0.0.1:5433/${CELL_DATABASE}
DIRECTORY_URL=postgres://directory_reader:${CELL_ROLE_PASSWORD}@127.0.0.1:5433/${DIRECTORY_DATABASE}
# The provisioner: with both set, the API also listens on PROVISION_HOST:PORT
# (default 127.0.0.1:3005) for the operator console's calls that create
# schools. Set both or neither; never give them to a public API.
CELL_PROVISION_URL=postgres://provisioner:${CELL_ROLE_PASSWORD}@127.0.0.1:5433/${CELL_DATABASE}
PROVISION_SECRET=
# PROVISION_PORT=3005
# PROVISION_HOST=127.0.0.1
# The operator console reaches the provisioner here, with the same secret.
# PROVISION_URL=http://127.0.0.1:3005
# The live-editing server, and where browsers reach it.
COLLAB_PORT=3002
COLLAB_URL=ws://127.0.0.1:3002
# Email through Resend, from a sender on a domain verified there; or email
# and SMS gateways taking a JSON POST. Without one, that channel is logged as
# skipped in the delivery log.
# RESEND_API_KEY=
# EMAIL_FROM=Farida <no-reply@mail.example.com>
# EMAIL_WEBHOOK_URL=
# SMS_WEBHOOK_URL=
# NOTIFY_WEBHOOK_TOKEN=
# Cloudflare Turnstile on the websites' forms: both keys, or neither. The
# widget's hostnames in Cloudflare must cover the schools' site domains.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# A school's portal is <school>.<PORTAL_DOMAIN> and its website
# <school>.<SITES_DOMAIN>; the bare portal domain asks for the school. Both
# names resolve locally, as every *.localhost name does.
PORTAL_DOMAIN=localhost
SITES_DOMAIN=site.localhost
# The edge's public IPv4, which a school's own apex domain points its A record
# at; without it only subdomains can be bound.
# EDGE_IPV4=203.0.113.10
# Reports each school's storage to the directory and binds and checks schools'
# own hosts; the API runs the hosts' verification worker with it.
DIRECTORY_SYNC_URL=postgres://directory_sync:${CELL_ROLE_PASSWORD}@127.0.0.1:5433/${DIRECTORY_DATABASE}
