{
  "name": "faridalms",
  "version": "0.0.0",
  "private": true,
  "description": "Multilingual, multi-school learning management system",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=.env run scripts/dev.ts",
    "build": "bun --env-file-if-exists=.env turbo run build",
    "start": "bun --env-file-if-exists=.env apps/web/.output/server/index.mjs",
    "preview": "bun --env-file-if-exists=.env apps/web/.output/server/index.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "bun --bun drizzle-kit generate --config packages/database/drizzle.config.ts",
    "db:migrate": "bun --env-file-if-exists=.env scripts/db.ts migrate",
    "db:seed": "bun --env-file-if-exists=.env scripts/db.ts seed",
    "db:reset": "bun --env-file-if-exists=.env scripts/db.ts reset",
    "lint": "oxlint --type-aware && bun scripts/check-i18n.ts",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "type-check": "tsc --noEmit --incremental false && tsc --noEmit --incremental false -p apps/ops",
    "test": "bun --env-file-if-exists=.env run vitest",
    "coverage": "bun --env-file=.env run vitest run --coverage",
    "test:e2e": "bun --env-file-if-exists=.env scripts/test-e2e.ts",
    "test:e2e:ui": "playwright test --ui --config=playwright.config.ts",
    "test:e2e:install": "playwright install --with-deps",
    "postinstall": "bun scripts/compile-i18n.ts && bun apps/api/scripts/python-wasi.ts && bun run --cwd apps/api studio && bun apps/api/scripts/p5.ts && bun apps/api/scripts/makecode.ts",
    "prepare": "bun .husky/install.mjs && bun scripts/setup.ts",
    "dev:web": "bun --env-file=.env run --cwd apps/web dev",
    "dev:api": "bun --env-file=.env run apps/api/src/index.ts",
    "start:api": "bun --env-file-if-exists=.env apps/api/src/index.ts",
    "ready": "bun run lint && bun run type-check && bun run test --run && bun run db:verify && bun run test:api && bun run test:e2e",
    "smoke:containers": "bun --env-file=.env scripts/smoke-containers.ts",
    "db:generate:directory": "bun --bun drizzle-kit generate --config packages/database/drizzle.directory.config.ts",
    "db:provision": "bun --env-file-if-exists=.env scripts/db.ts provision",
    "db:create": "bun --env-file-if-exists=.env scripts/db.ts create",
    "db:verify": "bun --env-file-if-exists=.env scripts/db-verify.ts",
    "test:db": "bun --env-file-if-exists=.env test --preload ./packages/database/test/setup.ts packages/database/test",
    "test:api": "bun --env-file-if-exists=.env test --preload ./apps/api/test/setup.ts apps/api/test"
  },
  "dependencies": {
    "@faridalms/database": "workspace:*",
    "@faridalms/domain": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.29.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "drizzle-kit": "1.0.0-rc.5",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nitro": "3.0.261029-rc",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-plugin-query": "^0.1.1",
    "oxlint-plugin-router": "^0.1.1",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.64.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.11.10",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0",
    "vitest-dom": "^0.1.1"
  },
  "lint-staged": {
    "*": "oxfmt",
    "*.{js,jsx,ts,tsx}": "oxlint --fix"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "lexical@0.53.0": "patches/lexical@0.53.0.patch"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "esbuild",
    "msw"
  ]
}
