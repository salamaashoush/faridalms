{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortImports": {
    "newlinesBetween": true,
    "groups": [
      "type-import",
      ["value-builtin", "value-external"],
      "type-internal",
      "value-internal",
      ["type-parent", "type-sibling", "type-index"],
      ["value-parent", "value-sibling", "value-index"],
      "unknown"
    ]
  },
  "sortTailwindcss": {
    "stylesheet": "./apps/web/src/styles/globals.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": [
    ".claude/**",
    "packages/ui/src/**",
    "**/node_modules/**",
    "apps/web/src/i18n/**",
    "apps/web/src/i18n-dev/**",
    "apps/web/src/routeTree.gen.ts",
    "apps/ops/src/routeTree.gen.ts",
    "**/.output/**",
    "**/.nitro/**",
    "dist/**",
    "coverage/**",
    "playwright-report/**",
    "packages/database/migrations/**",
    "bun.lock",
    "apps/api/src/pictures/pictures.json"
  ]
}
